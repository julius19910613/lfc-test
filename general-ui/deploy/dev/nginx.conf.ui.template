            proxy_pass http://${UTILS_IP}/;
        }
        location /faq/ {
            proxy_pass http://${SSM_UI_IP}/;
            proxy_set_header   Host    $host;
            proxy_set_header   X-Real-IP   $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
        }
        location /static/ueditor1.4.3.3 {
            proxy_pass http://${SSM_UI_IP};
            proxy_set_header   Host    $host;
            proxy_set_header   X-Real-IP   $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
        }
        location /ccs.html {
            rewrite ^/ccs.html(.*) /ccs/#/ redirect;
        }
        location /ccs {
            proxy_pass http://${CCS_UI_IP};
            proxy_set_header   Host    $host;
            proxy_set_header   X-Real-IP   $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
        }
        location /ccs_config_management.html {
            rewrite ^/ccs_config_management.html(.*) /ccs/#/ccs_config_management redirect;
        }
        location /ccs_config_param_define.html {
            rewrite ^/ccs_config_param_define.html(.*) /ccs/#/ccs_config_param_define redirect;
        }
        location /ai_module_management.html {
            rewrite ^/ai_module_management.html(.*) /ccs/#/ai_module_management redirect;
        }
        location /models-management.html {
            rewrite ^/models-management.html(.*) /ccs/#/models-management redirect;
        }
        location /diversity-manage.html {
