        }
        location /api {
            proxy_pass http://${API_IP};
        }
        location /localAuth {
            proxy_pass http://${LICENSE_CONTROLLER_IP};
        }
        location / {
            proxy_pass http://${SELF_IP}:8080;
        }

        location /nerFactoryDal/ {
            proxy_pass http://${NER_SERVER_IP}/nerFactoryDal/;
            # proxy_pass http://172.16.100.177:10525/nerFactoryDal/;
        }
        location /intent/ {
            proxy_pass http://172.16.102.54:15307/intent/;
            # proxy_pass http://172.16.100.177:10525/nerFactoryDal/;
        }

        location /aicc/api/cc/v1/ {
            proxy_pass http://172.16.101.58:7878;
        }
        location /tode {
            proxy_pass http://${REMOTE_IP};
        }
        location /option {
            proxy_pass http://172.16.102.186:4445;
        }

        location /q {
            proxy_pass http://172.16.102.186:4445;
        }
        location /unionpay {
            proxy_pass http://172.16.102.186:4445;
        }

        location /client/ws/ {
            # proxy_pass http://172.16.100.193:18000;
            proxy_pass  http://172.16.108.5:18000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "Upgrade";
            proxy_connect_timeout 600000s;
            proxy_read_timeout 600000s;
            proxy_send_timeout 600000s;
        }
        location /white_word {
            proxy_pass http://${REMOTE_IP}:9001/;
        }
        location /api.html {
            proxy_pass http://${REMOTE_IP}:10010;
        }
    }
}
