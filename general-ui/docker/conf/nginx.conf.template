#user  nginx;
worker_processes  10;

error_log  /var/log/nginx/error.log warn;
#pid        /var/run/nginx.pid;


events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    resolver ${NAMESERVER};

    log_format auth_header 'NGINX: [$time_local] “$request”  auth:"$user_id@$http_x_appid" from:"$remote_addr $http_x_forwarded_for" '
                      'ret:"code:$status size:$body_bytes_sent" info:[$http_referer][$http_user_agent]';
    underscores_in_headers on;
#   access_log  /var/log/nginx/access.log  main;
    access_log /dev/null;
    rewrite_log on;

    server_tag off;
    server_info off;
    server_tokens off;

    sendfile        on;
    #tcp_nopush     on;

    keepalive_timeout  65;

    #include /etc/nginx/conf.d/*.conf;

    client_max_body_size 25M;

    # rate limit setting, 150 request per second
    limit_req_zone  $binary_remote_addr  zone=req_one:10m rate=150r/s;
    # server {
    #     listen 81;
    #     listen [::]:81;

    #     # redirect to HTTPS
    #     rewrite ^(.*) https://$host$1 permanent;
    # }
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    upstream admin-api {
        dynamic_resolve fallback=stale fail_timeout=30s;
        server "${ADMIN_API_URL}";
    }

    upstream admin-auth {
        dynamic_resolve fallback=stale fail_timeout=30s;
        server "${ADMIN_TOKEN_AUTH_URL}";
    }

    upstream elk_stat_server_url {
        dynamic_resolve fallback=stale fail_timeout=30s;
        server "${ADMIN_ELK_STAT_SERVER_URL}";
    }

    upstream knowledge_kbqa_url {
        dynamic_resolve fallback=stale fail_timeout=30s;
        server "${ADMIN_KNOWLEDGE_KBQA_URL}";
    }

    upstream knowledge_graph_url {
        dynamic_resolve fallback=stale fail_timeout=30s;
        server "${ADMIN_KNOWLEDGE_GRAPH_URL}";
    }

    upstream utils_server_url {
        dynamic_resolve fallback=stale fail_timeout=30s;
        server "${ADMIN_UTILS_URL}";
    }

    upstream admin_ner_api {
        dynamic_resolve fallback=stale fail_timeout=30s;
        server "${ADMIN_NER_API_URL}";
    }

    upstream admin_intent_engine {
        dynamic_resolve fallback=stale fail_timeout=30s;
        server "${ADMIN_INTENTS_URL}";
    }

    upstream admin_lqcheck_conflict {
        dynamic_resolve fallback=stale fail_timeout=30s;
        server "${ADMIN_LQCHECK_CONFLICT_CHECK_URL}";
    }

    upstream admin_license_controller {
        dynamic_resolve fallback=stale fail_timeout=30s;
        server "${ADMIN_LICENSE_CONTROLLER_URL}";
    }

    upstream admin_api_adapter_service {
        dynamic_resolve fallback=stale fail_timeout=30s;
        server "${ADMIN_API_ADAPTER_URL}";
    }

    upstream admin_capsule_controller {
        dynamic_resolve fallback=stale fail_timeout=30s;
        server "${ADMIN_CAPSULE_CONTROLLER_URL}";
    }

    upstream admin_common_resources {
        dynamic_resolve fallback=stale fail_timeout=30s;
        server "${ADMIN_COMMON_UI_URL}";
    }

    gzip  on;
    gzip_static  on;

    server {
        access_log /var/log/nginx/access.log auth_header;

        set $flag "";
        set $appid_temp "";
        set $appid "";
        set $user_id "";
        set $enterprise_id "";

        if ($http_x_appid != "null") {
            set $appid $http_x_appid;
        }

        if ($appid = "") {
            set $flag "1";
        }

        if ($http_cookie ~* "appid=([a-z0-9]+)(?:;|$)") {
            set $flag "${flag}2";
            set $appid_temp $1;
        }

        if ($flag = "12") {
            set $appid $appid_temp;
        }

        if ($http_cookie ~* "userid=([.%\-a-zA-Z0-9_]+)(?:;|$)") {
            set $user_id $1;
        }

        if ($http_x_userid != "") {
            set $user_id $http_x_userid;
        }

        if ($http_cookie ~* "enterprise=([.%\-a-zA-Z0-9_]+)(?:;|$)") {
            set $enterprise_id $1;
        }

        if ($enterprise_id = "") {
            set $enterprise_id $http_x_enterprise;
        }

        if ($enterprise_id = "") {
            set $enterprise_id $http_x_enterpriseid;
        }

        set $pre_record "${ADMIN_PRE_RECORD}";

        listen 81;
        #listen [::]:80;
        proxy_set_header X-AppID $appid;
        proxy_set_header X-UserID $user_id;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-EnterpriseID $enterprise_id;
        proxy_http_version 1.1;
        add_header X-Frame-Options SAMEORIGIN;
        add_header Content-Security-Policy "img-src * blob: data:; 'unsafe-inline' 'unsafe-eval' data:;media-src * blob: data:;";

        location /admin {
            # auth_request /auth/v1/appid/validate;
            proxy_http_version 1.1;
            proxy_pass http://admin-auth;
        }

        location /auth {
            # auth_request /auth/v1/appid/validate
            proxy_http_version 1.1;
            proxy_pass http://admin-auth;
        }


        location /stats {
            proxy_http_version 1.1;
            proxy_pass http://elk_stat_server_url;
        }

        # ========== legacy houta ==========
        location = /php/api/ApiKey/task_engine_app.php {
            proxy_http_version 1.1;
            proxy_pass http://admin-api/api/v1/task/apps;
        }
        location = /php/api/ApiKey/task_engine_scenario.php {
            proxy_http_version 1.1;
            proxy_pass http://admin-api/api/v1/task/scenarios;
        }
        location = /php/api/ApiKey/scenario_json_upload.php {
            proxy_http_version 1.1;
            proxy_pass http://admin-api/api/v1/task/scenarios-upload;
        }
        location = /php/api/ApiKey/mapping_table_list.php {
            proxy_set_header Host $host;
            proxy_set_header Authorization $appid;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Appid $appid;
            proxy_set_header X-UserID $user_id;
            proxy_pass http://utils_server_url/wordbank/v2/getCatalogListByModule;
            # proxy_http_version 1.1;
            # proxy_pass http://admin-api/api/v2/task/mapping-tables;
        }
        location = /php/api/ApiKey/mapping_table_upload.php {
            proxy_set_header Authorization $appid;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Appid $appid;
            proxy_set_header X-UserID $user_id;
            proxy_http_version 1.1;
            proxy_pass http://admin-api/api/v1/task/mapping-table/upload;
        }
        location = /php/api/ApiKey/mapping_table_delete.php {
            proxy_set_header Authorization $appid;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Appid $appid;
            proxy_set_header X-UserID $user_id;
            proxy_http_version 1.1;
            proxy_pass http://admin-api/api/v1/task/mapping-table/delete;
        }
        location = /php/api/ApiKey/mapping_table_download.php {
            proxy_set_header Authorization $appid;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Appid $appid;
            proxy_set_header X-UserID $user_id;
            proxy_http_version 1.1;
            proxy_pass http://admin-api/api/v1/task/mapping-table/export;
        }
        location = /php/api/ApiKey/tde_register.php {
            proxy_set_header Authorization $appid;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Appid $appid;
            proxy_set_header X-UserID $user_id;
            proxy_http_version 1.1;
            proxy_pass http://172.17.0.1:10999/tde/register;
        }
        location = /php/api/ApiKey/spreadsheet.php {
            proxy_set_header Authorization $appid;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Appid $appid;
            proxy_set_header X-UserID $user_id;
            proxy_http_version 1.1;
            proxy_pass http://admin-api/api/v1/task/spreadsheet;
        }

        # legacy php code, from 2.0 UI
        location ~ ^/php/ {
            if ($appid = "") {
                return 401;
            }
            if ($user_id = "") {
                return 401;
            }
            # TODO: handle invalid cookie/user_id

            set $is_exists 0;
            rewrite \/php\/(.*) /$1 break;

            include fastcgi_params;
            fastcgi_param HTTP_HOST 172.17.0.1;
            fastcgi_param HTTP_X_APPID $appid;
            fastcgi_param HTTP_X_USERID $user_id;
            fastcgi_param HTTP_X_REAL_IP $remote_addr;

            root /build/dist;
            fastcgi_split_path_info ^(.+?\.php)(/.*)$;

            # since rewrite might cause leading / and proxy pass will cause double //, check even root/scrip or rootscrip either.
            if (-f $document_root$fastcgi_script_name) {
                set $is_exists 1;
            }
            if (-f $document_root/$fastcgi_script_name) {
                set $is_exists 1;
            }

            if ($is_exists != 1) {
                return 404;
            }

            fastcgi_pass 127.0.0.1:9000;
            fastcgi_param REQUEST_METHOD $request_method;
            fastcgi_param SCRIPT_FILENAME $fastcgi_script_name;
            fastcgi_param QUERY_STRING $query_string;
            # fastcgi_param SERVER_NAME 172.17.0.1;
        }

        # response/sdk(vip-adapter) call directly without any auth cookie
        location ~ ^/(api/ApiKey|api/APP)/ {
            root /build/dist;
            include fastcgi_params;
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_param REQUEST_METHOD $request_method;
            fastcgi_param SCRIPT_FILENAME $fastcgi_script_name;
            fastcgi_param QUERY_STRING $query_string;
            fastcgi_param SERVER_NAME 172.17.0.1;
        }

        location = /im-admin/login {
            rewrite ^.*$ /login.html;
            break;
        }

        location /BF/scenario {
            root   /build/dist;
            index  index.html index.htm;
        }
        location /xeonKgDal {
            proxy_http_version 1.1;
            proxy_set_header   Host    $host;
            proxy_set_header   X-Real-IP   $remote_addr;
            proxy_pass http://knowledge_graph_url;
        }
        location /api/v1/kbqa {
            proxy_http_version 1.1;
            proxy_pass http://knowledge_kbqa_url;
        }

        location /nerFactoryDal/ {
            proxy_set_header   Host    $host;
            proxy_set_header   X-Real-IP   $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_pass http://admin_ner_api;
        }
        location /dialogActClassify/ {
            proxy_set_header   Host    $host;
            proxy_set_header   X-Real-IP   $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_pass http://admin_ner_api;
        }
        location /aicc/api/cc/ {
            proxy_pass http://$pre_record;
        }
        location /ssm.html {
            rewrite ^/ssm.html(.*) faq/#/ssm redirect;
        }
        location /history.html {
            rewrite ^/history.html(.*) faq/#/history redirect;
        }
        location /adm {
            proxy_set_header   Host    $host;
            proxy_set_header   X-Real-IP   $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_pass http://utils_server_url/;
        }


        location /ml {
            proxy_set_header   Host    $host;
            proxy_set_header   X-Real-IP   $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_pass http://utils_server_url;
        }

        location /adapter {
            proxy_pass http://admin_api_adapter_service/;
            proxy_set_header   Host    $host;
            proxy_set_header   X-Real-IP   $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
        }

        location /common_resources/ {
            proxy_pass http://admin_common_resources/;
            proxy_set_header   Host    $host;
            proxy_set_header   X-Real-IP   $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
        }

        location /client/ws/ {
            proxy_pass http://172.16.100.193:18000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "Upgrade";
            proxy_connect_timeout 600000s;
            proxy_read_timeout 600000s;
            proxy_send_timeout 600000s;
        }


        location /intent {
            proxy_http_version 1.1;
            proxy_pass http://admin_intent_engine/;
        }

        location /localAuth {
            proxy_set_header   Host    $host;
            proxy_set_header   X-Real-IP   $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_pass  http://admin_license_controller;
        }

        location /capsule{
            proxy_set_header   Host    $host;
            proxy_set_header   X-Real-IP   $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_pass http://admin_capsule_controller;
        }

        # golang /api/v1
        location /Files/sq/images {
            proxy_http_version 1.1;
            proxy_pass http://admin-api/api/v1/media/image;
        }

        location /api {
            add_header Cache-Control no-store;
            add_header Cache-Control private;
            proxy_http_version 1.1;
            proxy_pass http://admin-api;
        }

        location /Files {
            proxy_http_version 1.1;
            proxy_pass http://admin-api;
        }

        location = uiversion {
            proxy_http_version 1.1;
            proxy_pass http://127.0.0.1:81/uiversion.html;
        }

        location /data_health_check/download {
            proxy_http_version 1.1;
            proxy_pass http://admin_lqcheck_conflict;
        }

        # /Files will go here
        location / {
            root   /build/dist;
            index  index.html index.htm;
        }
        ## error_page 403 /403.html;
    }
}
